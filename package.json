{
	"name": "ruxs",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.11",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"drizzle-orm": "^0.45.2",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/bun": "^1.4.2",
		"@types/node": "^22.20.2",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "^4.131.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "bun run build && bun run start",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
	}
}